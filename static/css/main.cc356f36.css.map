/* =========================================================
   LUXURY WATCH PRODUCT VIEW — HAUTE HORLOGERIE SYSTEM
   ========================================================= */

.luxury-product-page {
  width: 95%;
  max-width: 1300px;
  margin: 3.8rem auto 4rem auto;
  color: #1a1a1a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Georgia, serif;
}

/* Top Navigation & Breadcrumb */
.luxury-top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid #d4af3740;
  margin-bottom: 2.25rem;
}

.luxury-breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.85rem;
  color: #8c827a;
  flex-wrap: wrap;
}

.luxury-crumb-link {
  color: #1a1a1a;
  text-decoration: none;
  font-family: Georgia, serif;
  font-style: italic;
  transition: color 0.2s;
}

.luxury-crumb-link:hover {
  color: #b89130;
}

.luxury-crumb-sep {
  color: #c5a059;
  font-size: 0.7rem;
}

.luxury-crumb-category {
  color: #b89130;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
}

.luxury-crumb-current {
  color: #1a1a1a;
  font-weight: 600;
}

.luxury-top-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.luxury-atelier-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: #11141a;
  color: #e5c98e;
  border: 1px solid #c5a05980;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.35rem 0.85rem;
  border-radius: 4px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.luxury-share-btn {
  background: #fbf9f5;
  border: 1px solid #d4af3760;
  color: #8c733e;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}

.luxury-share-btn:hover {
  background: #11141a;
  color: #e5c98e;
}

/* Main Luxury Grid */
.luxury-main-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
}

@media (min-width: 900px) {
  .luxury-main-grid {
    grid-template-columns: 46% 54%;
    align-items: start;
    gap: 3.5rem;
  }
}

/* Visual Column */
.luxury-visual-column {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.luxury-image-stage {
  position: relative;
  background: radial-gradient(circle at 50% 40%, #1e222d 0%, #0a0d14 100%);
  border: 1px solid #c5a05955;
  border-radius: 16px;
  padding: 3rem 1.5rem 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 20px 45px -12px rgba(10, 13, 20, 0.4), inset 0 0 40px rgba(197, 160, 89, 0.08);
}

.luxury-halo-glow {
  position: absolute;
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.luxury-seal-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(10, 13, 20, 0.85);
  border: 1px solid #c5a05988;
  color: #e5c98e;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.3rem 0.65rem;
  border-radius: 30px;
  letter-spacing: 0.08em;
  backdrop-filter: blur(8px);
}

.luxury-hallmark {
  position: absolute;
  bottom: 0.85rem;
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  color: #c5a05988;
  text-transform: uppercase;
}

.luxury-img-wrapper {
  width: 100%;
  max-width: 360px;
  height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  z-index: 1;
}

.luxury-primary-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.75));
  transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.luxury-primary-img:hover {
  transform: scale(1.04) translateY(-6px);
}

.luxury-materials-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  justify-content: center;
  margin-top: 1rem;
  width: 100%;
  z-index: 1;
}

.luxury-material-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(212, 175, 55, 0.3);
  color: #e5c98e;
  font-size: 0.75rem;
  padding: 0.35rem 0.75rem;
  border-radius: 9999px;
  backdrop-filter: blur(6px);
}

.luxury-material-chip .mat-icon {
  color: #e5c98e;
}

/* Privileges Card */
.luxury-privileges-card {
  background: #fbf9f5;
  border: 1px solid #e7ded0;
  border-radius: 14px;
  padding: 1.5rem;
}

.luxury-privileges-heading {
  font-family: Georgia, serif;
  font-size: 0.82rem;
  letter-spacing: 0.15em;
  color: #8c733e;
  text-transform: uppercase;
  margin-bottom: 1.15rem;
}

.luxury-privileges-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.privilege-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.privilege-icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #11141a;
  color: #e5c98e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
  border: 1px solid #c5a05988;
}

.privilege-item strong {
  display: block;
  font-size: 0.85rem;
  color: #1a1a1a;
  margin-bottom: 0.15rem;
}

.privilege-item p {
  font-size: 0.78rem;
  color: #6d645a;
  margin: 0;
  line-height: 1.4;
}

/* Right Column */
.luxury-details-column {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.luxury-brand-header {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.luxury-brand-label {
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  color: #b89130;
  font-weight: 700;
  text-transform: uppercase;
}

.luxury-brand-name {
  font-family: Georgia, serif;
  font-size: 1.35rem;
  color: #1a1a1a;
  font-weight: 700;
}

.luxury-product-title {
  font-family: Georgia, "Playfair Display", serif;
  font-size: 1.75rem;
  line-height: 1.25;
  color: #11141a;
  font-weight: 600;
  margin: 0;
}

@media (min-width: 768px) {
  .luxury-product-title {
    font-size: 2.25rem;
  }
}

/* Ratings */
.luxury-ratings-bar {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.5rem 0.85rem;
  background: #fbf9f5;
  border: 1px solid #e7ded0;
  border-radius: 6px;
  width: fit-content;
}

.luxury-stars {
  display: flex;
  gap: 2px;
}

.star-gold {
  color: #d4af37;
  font-size: 1.05rem;
}

.luxury-rating-score {
  font-weight: 700;
  color: #11141a;
  font-size: 0.88rem;
}

.luxury-collector-count {
  font-size: 0.8rem;
  color: #8c827a;
  font-style: italic;
}

/* Pricing Box */
.luxury-pricing-box {
  background: #0f1218;
  color: white;
  border: 1px solid #c5a05966;
  border-radius: 12px;
  padding: 1.4rem 1.6rem;
  box-shadow: 0 12px 28px rgba(10, 13, 20, 0.25);
}

.luxury-price-row {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 0.4rem;
}

.luxury-price-val {
  font-family: Georgia, serif;
  font-size: 2.2rem;
  font-weight: 700;
  color: #e5c98e;
  letter-spacing: -0.01em;
}

.luxury-mrp-val {
  font-size: 0.95rem;
  color: #949aa8;
  font-style: italic;
}

.luxury-tax-note {
  font-size: 0.78rem;
  color: #adb4c4;
  margin: 0;
  line-height: 1.4;
}

/* Story Card */
.luxury-story-card {
  background: #fbf9f5;
  border-left: 3px solid #c5a059;
  padding: 1.1rem 1.3rem;
  border-radius: 0 8px 8px 0;
}

.luxury-story-heading {
  font-family: Georgia, serif;
  font-size: 0.78rem;
  letter-spacing: 0.15em;
  color: #b89130;
  margin-bottom: 0.35rem;
}

.luxury-story-text {
  font-size: 0.95rem;
  line-height: 1.65;
  color: #453e38;
  margin: 0;
}

/* Strap Selection */
.luxury-strap-selection {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.luxury-option-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #8c733e;
  text-transform: uppercase;
}

.luxury-strap-buttons {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.strap-btn {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.65rem 1.1rem;
  border: 1px solid #d4af3770;
  background: white;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 500;
  color: #3e3731;
  cursor: pointer;
  transition: all 0.2s;
}

.strap-btn .check-icon {
  opacity: 0;
  color: #b89130;
}

.strap-btn.active {
  border-color: #b89130;
  background: #fdfaf2;
  color: #8c733e;
  font-weight: 700;
}

.strap-btn.active .check-icon {
  opacity: 1;
}

/* Actions Bar */
.luxury-actions-bar {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

@media (min-width: 600px) {
  .luxury-actions-bar {
    flex-direction: row;
  }
}

.luxury-acquire-btn {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  background: linear-gradient(135deg, #c5a059 0%, #a48135 100%);
  color: #0b0d12;
  border: 1px solid #e5c98e;
  padding: 1.05rem 1.5rem;
  border-radius: 6px;
  font-size: 0.95rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(184, 145, 48, 0.3);
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.luxury-acquire-btn:hover {
  background: linear-gradient(135deg, #d4af37 0%, #b89130 100%);
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(184, 145, 48, 0.45);
}

.luxury-vault-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: transparent;
  border: 1.5px solid #11141a;
  color: #11141a;
  padding: 1.05rem 1.25rem;
  border-radius: 6px;
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: all 0.2s;
}

.luxury-vault-btn:hover {
  background: #11141a;
  color: #e5c98e;
  border-color: #11141a;
}

.luxury-vault-btn.vaulted {
  background: #fdfaf2;
  border-color: #b89130;
  color: #8c733e;
}

.btn-icon.gold {
  color: #b89130;
}

/* Guarantee Grid */
.luxury-guarantee-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  padding-top: 0.6rem;
  border-top: 1px solid #e7ded0;
}

.luxury-guarantee-cell {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.luxury-guarantee-cell .l-icon {
  color: #b89130;
  font-size: 1.35rem;
  flex-shrink: 0;
}

.luxury-guarantee-cell div {
  display: flex;
  flex-direction: column;
}

.luxury-guarantee-cell strong {
  font-size: 0.75rem;
  color: #1a1a1a;
}

.luxury-guarantee-cell span {
  font-size: 0.68rem;
  color: #8c827a;
}

/* Tabs Section */
.luxury-tabs-wrapper {
  margin-top: 1rem;
  background: white;
  border: 1px solid #e7ded0;
  border-radius: 10px;
  overflow: hidden;
}

.luxury-tab-headers {
  display: flex;
  background: #fbf9f5;
  border-bottom: 1px solid #e7ded0;
}

.tab-btn {
  flex: 1;
  padding: 0.9rem 1rem;
  border: none;
  background: transparent;
  font-family: Georgia, serif;
  font-size: 0.85rem;
  font-weight: 700;
  color: #8c827a;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.2s;
}

.tab-btn.active {
  color: #b89130;
  border-bottom-color: #b89130;
  background: white;
}

.luxury-tab-body {
  padding: 1.35rem;
}

.luxury-specs-table {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  padding-bottom: 0.5rem;
  border-bottom: 1px dashed #e7ded0;
  font-size: 0.85rem;
}

.spec-key {
  color: #8c827a;
  font-weight: 500;
}

.spec-val {
  color: #1a1a1a;
  font-weight: 700;
}

.craftsmanship-content p,
.concierge-content p {
  font-size: 0.88rem;
  line-height: 1.6;
  color: #4a423a;
  margin: 0 0 0.65rem 0;
}

/* Related Vault Section */
.luxury-related-section {
  margin-top: 4rem;
  padding-top: 2.5rem;
  border-top: 1px solid #d4af3740;
}

.luxury-related-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 1.75rem;
}

.sub-title {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  color: #b89130;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
}

.luxury-related-title {
  font-family: Georgia, serif;
  font-size: 1.25rem;
  color: #1a1a1a;
  margin: 0;
}

.luxury-view-all {
  color: #b89130;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.luxury-related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.35rem;
}

.luxury-related-card {
  display: flex;
  flex-direction: column;
  background: white;
  border: 1px solid #e7ded0;
  border-radius: 10px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: all 0.3s;
}

.luxury-related-card:hover {
  transform: translateY(-4px);
  border-color: #c5a059;
  box-shadow: 0 14px 28px rgba(197, 160, 89, 0.15);
}

.luxury-card-img-wrap {
  height: 190px;
  background: radial-gradient(circle at center, #232733 0%, #0d1017 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.luxury-card-img-wrap img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.7));
}

.luxury-card-info {
  padding: 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.card-brand {
  font-size: 0.72rem;
  font-weight: 700;
  color: #b89130;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.card-name {
  font-family: Georgia, serif;
  font-size: 0.88rem;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.5rem;
}

.card-price {
  font-family: Georgia, serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #b89130;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  font-size: 0.8rem;
  color: #d4af37;
  font-weight: 700;
}
