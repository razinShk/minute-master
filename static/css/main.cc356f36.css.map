/* =========================================================
   SMART WATCH PRODUCT VIEW — WEARABLE TECH & OLED SYSTEM
   ========================================================= */

.smart-product-page {
  width: 95%;
  max-width: 1300px;
  margin: 3.8rem auto 4rem auto;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Top Navigation & Breadcrumb */
.smart-top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
  padding: 0.75rem 0;
  border-bottom: 2px solid #e2e8f0;
  margin-bottom: 2rem;
}

.smart-breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: #64748b;
  flex-wrap: wrap;
}

.smart-crumb-link {
  color: #0f172a;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s;
}

.smart-crumb-link:hover {
  color: #6366f1;
}

.smart-crumb-sep {
  color: #cbd5e1;
}

.smart-crumb-category {
  color: #6366f1;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.05em;
}

.smart-crumb-current {
  color: #0f172a;
  font-weight: 600;
}

.smart-top-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.smart-pulse-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: #0b0f19;
  color: #38bdf8;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.35rem 0.8rem;
  border-radius: 9999px;
  letter-spacing: 0.08em;
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.live-dot {
  width: 7px;
  height: 7px;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 8px #10b981;
  animation: pulse-dot 1.8s infinite;
}

@keyframes pulse-dot {
  0% {
    transform: scale(0.95);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  }
  70% {
    transform: scale(1.1);
    box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
  }
  100% {
    transform: scale(0.95);
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
  }
}

.smart-share-btn {
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  color: #0f172a;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}

.smart-share-btn:hover {
  background: #0b0f19;
  color: #38bdf8;
}

/* Two-Column Grid */
.smart-main-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
}

@media (min-width: 900px) {
  .smart-main-grid {
    grid-template-columns: 46% 54%;
    align-items: start;
    gap: 3.5rem;
  }
}

/* Visual Column */
.smart-visual-column {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.smart-image-stage {
  position: relative;
  background: radial-gradient(circle at center, #1e1b4b 0%, #0b0f19 100%);
  border-radius: 16px;
  padding: 2.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 16px 36px -10px rgba(15, 23, 42, 0.35);
  border: 1px solid rgba(99, 102, 241, 0.25);
}

.smart-ambient-glow {
  position: absolute;
  width: 280px;
  height: 280px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

.smart-tech-corners .corner {
  position: absolute;
  width: 12px;
  height: 12px;
  border: 2px solid #38bdf8;
}

.smart-tech-corners .corner.tl {
  top: 12px;
  left: 12px;
  border-right: none;
  border-bottom: none;
}
.smart-tech-corners .corner.tr {
  top: 12px;
  right: 12px;
  border-left: none;
  border-bottom: none;
}
.smart-tech-corners .corner.bl {
  bottom: 12px;
  left: 12px;
  border-right: none;
  border-top: none;
}
.smart-tech-corners .corner.br {
  bottom: 12px;
  right: 12px;
  border-left: none;
  border-top: none;
}

.smart-telemetry-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(11, 15, 25, 0.85);
  border: 1px solid rgba(56, 189, 248, 0.4);
  color: #38bdf8;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.3rem 0.65rem;
  border-radius: 6px;
  letter-spacing: 0.05em;
  backdrop-filter: blur(8px);
}

.smart-img-wrapper {
  width: 100%;
  max-width: 360px;
  height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  z-index: 1;
}

.smart-primary-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.7));
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.smart-primary-img:hover {
  transform: scale(1.05) translateY(-4px);
}

.smart-sensor-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  justify-content: center;
  margin-top: 1rem;
  width: 100%;
  z-index: 1;
}

.smart-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #e2e8f0;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.35rem 0.8rem;
  border-radius: 9999px;
  backdrop-filter: blur(8px);
}

.smart-chip .chip-icon {
  font-size: 0.95rem;
  color: #38bdf8;
}

.smart-chip .pulse-red {
  color: #f43f5e;
}
.smart-chip .green {
  color: #10b981;
}

/* Telemetry Card */
.smart-telemetry-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 1.25rem 1.5rem;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
}

.smart-telemetry-heading {
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #64748b;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.smart-telemetry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.85rem;
}

.telemetry-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.6rem;
  background: #f8fafc;
  border-radius: 8px;
  border-left: 3px solid #6366f1;
}

.telemetry-icon-wrap {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  color: white;
  flex-shrink: 0;
}

.telemetry-icon-wrap.heart {
  background: #f43f5e;
}
.telemetry-icon-wrap.bluetooth {
  background: #0284c7;
}
.telemetry-icon-wrap.sport {
  background: #10b981;
}
.telemetry-icon-wrap.chip {
  background: #8b5cf6;
}

.telemetry-info {
  display: flex;
  flex-direction: column;
}

.telemetry-title {
  font-size: 0.75rem;
  font-weight: 700;
  color: #0f172a;
}

.telemetry-sub {
  font-size: 0.7rem;
  color: #64748b;
}

/* Right Details Column */
.smart-details-column {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.smart-brand-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.smart-brand-chip {
  background: #6366f1;
  color: white;
  font-size: 0.8rem;
  font-weight: 800;
  padding: 0.25rem 0.85rem;
  border-radius: 4px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.smart-os-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: #64748b;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.smart-product-title {
  font-size: 1.6rem;
  line-height: 1.3;
  font-weight: 800;
  color: #0f172a;
  margin: 0;
}

@media (min-width: 768px) {
  .smart-product-title {
    font-size: 2.1rem;
  }
}

/* Ratings */
.smart-ratings-bar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #f8fafc;
  padding: 0.5rem 0.85rem;
  border-radius: 8px;
  width: fit-content;
  border: 1px solid #e2e8f0;
}

.smart-stars {
  display: flex;
  gap: 2px;
  font-size: 1.05rem;
}

.star-cyan {
  color: #0284c7;
}
.star-dim {
  color: #cbd5e1;
}

.smart-rating-score {
  font-weight: 800;
  color: #0f172a;
  font-size: 0.9rem;
}

.smart-rating-count {
  color: #64748b;
  font-size: 0.8rem;
}

/* Pricing Box */
.smart-pricing-box {
  background: linear-gradient(135deg, #0b0f19 0%, #1e1b4b 100%);
  color: white;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.15);
  border: 1px solid rgba(99, 102, 241, 0.3);
}

.smart-price-row {
  display: flex;
  align-items: baseline;
  gap: 0.85rem;
  margin-bottom: 0.4rem;
}

.smart-current-price {
  font-size: 2.1rem;
  font-weight: 900;
  color: #38bdf8;
  letter-spacing: -0.02em;
}

.smart-mrp-price {
  font-size: 1.15rem;
  color: #94a3b8;
  text-decoration: line-through;
}

.smart-discount-pill {
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
  color: white;
  font-size: 0.72rem;
  font-weight: 800;
  padding: 0.25rem 0.65rem;
  border-radius: 4px;
}

.smart-battery-status {
  font-size: 0.78rem;
  color: #94a3b8;
  margin: 0;
}

/* Description Card */
.smart-description-card {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 1rem 1.25rem;
}

.smart-description-text {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #334155;
  margin: 0;
}

/* Finish Selection */
.smart-edition-selection {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.smart-option-label {
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #64748b;
}

.smart-edition-buttons {
  display: flex;
  gap: 0.65rem;
  flex-wrap: wrap;
}

.edition-btn {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.6rem 0.9rem;
  border: 1px solid #cbd5e1;
  background: white;
  border-radius: 8px;
  font-size: 0.82rem;
  font-weight: 600;
  color: #334155;
  cursor: pointer;
  transition: all 0.2s;
}

.edition-btn .verified-icon {
  opacity: 0;
  color: #6366f1;
}

.edition-btn.selected {
  border-color: #6366f1;
  background: #eef2ff;
  color: #4338ca;
}

.edition-btn.selected .verified-icon {
  opacity: 1;
}

/* Actions Bar */
.smart-actions-bar {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

@media (min-width: 600px) {
  .smart-actions-bar {
    flex-direction: row;
  }
}

.smart-cart-btn {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
  color: white;
  border: none;
  padding: 1rem 1.5rem;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35);
  transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.smart-cart-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 26px rgba(6, 182, 212, 0.45);
}

.smart-wishlist-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: white;
  border: 2px solid #0f172a;
  color: #0f172a;
  padding: 1rem 1.25rem;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
}

.smart-wishlist-btn:hover {
  background: #0f172a;
  color: #38bdf8;
}

.smart-wishlist-btn.synced {
  border-color: #8b5cf6;
  background: #f5f3ff;
  color: #7c3aed;
}

.btn-icon.purple {
  color: #8b5cf6;
}

/* Guarantee Grid */
.smart-guarantee-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  padding-top: 0.5rem;
  border-top: 1px solid #e2e8f0;
}

.smart-guarantee-cell {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.smart-guarantee-cell .s-icon {
  color: #6366f1;
  font-size: 1.35rem;
  flex-shrink: 0;
}

.smart-guarantee-cell div {
  display: flex;
  flex-direction: column;
}

.smart-guarantee-cell strong {
  font-size: 0.75rem;
  color: #0f172a;
}

.smart-guarantee-cell span {
  font-size: 0.7rem;
  color: #64748b;
}

/* Tabs Section */
.smart-tabs-wrapper {
  margin-top: 1rem;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
}

.smart-tab-headers {
  display: flex;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.tab-btn {
  flex: 1;
  padding: 0.85rem 1rem;
  border: none;
  background: transparent;
  font-size: 0.85rem;
  font-weight: 700;
  color: #64748b;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  transition: all 0.2s;
}

.tab-btn.active {
  color: #4f46e5;
  border-bottom-color: #4f46e5;
  background: white;
}

.smart-tab-body {
  padding: 1.25rem;
}

.smart-specs-table {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  padding-bottom: 0.5rem;
  border-bottom: 1px dashed #e2e8f0;
  font-size: 0.85rem;
}

.spec-key {
  color: #64748b;
  font-weight: 500;
}

.spec-val {
  color: #0f172a;
  font-weight: 700;
}

.os-content p {
  font-size: 0.85rem;
  line-height: 1.55;
  color: #475569;
  margin: 0 0 0.5rem 0;
}

.smart-package-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: #334155;
  font-weight: 600;
}

/* Related Section */
.smart-related-section {
  margin-top: 4rem;
  padding-top: 2rem;
  border-top: 2px solid #e2e8f0;
}

.smart-related-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.sub-title {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  color: #6366f1;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
}

.smart-related-title {
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #0f172a;
  margin: 0;
}

.smart-view-all {
  color: #4f46e5;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 700;
}

.smart-related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
}

.smart-related-card {
  display: flex;
  flex-direction: column;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: all 0.25s;
}

.smart-related-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.15);
  border-color: #6366f1;
}

.smart-card-img-wrap {
  height: 180px;
  background: radial-gradient(circle at center, #1e1b4b 0%, #0b0f19 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.smart-card-img-wrap img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.7));
}

.smart-card-info {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.card-brand {
  font-size: 0.75rem;
  font-weight: 700;
  color: #6366f1;
  text-transform: uppercase;
}

.card-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.5rem;
}

.card-price {
  font-size: 1.05rem;
  font-weight: 800;
  color: #0f172a;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 0.2rem;
  font-size: 0.8rem;
  color: #0284c7;
  font-weight: 700;
}
